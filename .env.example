# ───────────────────────────────────────────────────────────────
# 佐賀 蔵めぐり — 環境変数
#
# ★ Vercel にデプロイする場合、ここを手で書く必要はありません。
#   Vercel の管理画面から Neon と Clerk を追加すると、
#   下の値はすべて自動で入ります。docs/デプロイ手順.md を見てください。
#
# ローカルで開発するときだけ、このファイルを .env.local にコピーして使います。
# ───────────────────────────────────────────────────────────────

# データベース（Vercel Marketplace の Neon を追加すると自動で入る）
#
# ※ Vercel から入れると、名前にプレフィックスが付きます。
#    例: STORAGE_POSTGRES_URL / STORAGE_DATABASE_URL_UNPOOLED
#    アプリはどちらの名前でも読めるので、気にしなくて構いません。
DATABASE_URL=

# ログイン（Vercel Marketplace の Clerk を追加すると自動で入る）
#
# ※ こちらも同様です。
#    例: AUTHENTICATION_CLERK_SECRET_KEY
#        NEXT_PUBLIC_AUTHENTICATION_CLERK_PUBLISHABLE_KEY
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# ── ここから下の 2 つは、Vercel にデプロイするときに入力できます ──
#    （New Project 画面の「Environment Variables」の欄）

# 主催者にするメールアドレス（カンマ区切り）。
#
# ★ デプロイ時に入れておくことを強くすすめます ★
# 空のままだと「最初にログインした人」が主催者になります。URL を先に誰かに
# 開かれると、その人が運営権限を持ってしまいます。
# また Clerk を開発用から本番用に切り替えるとユーザーIDが変わるため、
# ここを設定していないと主催者権限が外れます。
ORGANIZER_EMAILS=

# 「酒蔵特別枠」で参加する人に配る招待コード。空にすると特別枠は使えません。
BREWERY_GUEST_INVITE_CODE=

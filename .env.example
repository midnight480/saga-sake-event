# ───────────────────────────────────────────────────────────────
# 佐賀 蔵めぐり — 環境変数
#
# ★ Vercel にデプロイする場合、ここを手で書く必要はありません。
#   Vercel の管理画面から Neon と Clerk を追加すると、
#   下の値はすべて自動で入ります。docs/デプロイ手順.md を見てください。
#
# ローカルで開発するときだけ、このファイルを .env.local にコピーして使います。
# ───────────────────────────────────────────────────────────────

# データベース（Vercel Marketplace の Neon を追加すると自動で入る）
DATABASE_URL=

# ログイン（Vercel Marketplace の Clerk を追加すると自動で入る）
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# ── ここから下は任意。空でも動きます ──

# 主催者にするメールアドレス（カンマ区切り）。
# 空の場合は「最初にログインした人」が主催者になります。
ORGANIZER_EMAILS=

# 「酒蔵特別枠」で参加する人に配る招待コード。空にすると特別枠は使えません。
BREWERY_GUEST_INVITE_CODE=
